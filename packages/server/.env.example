# Server environment variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mma_manager

# JWT signing secret — required, at least 32 random characters. The server
# refuses to start without it or with this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-random-secret

# Server port
PORT=3001

# Redis (used by BullMQ for fight resolve scheduler)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
